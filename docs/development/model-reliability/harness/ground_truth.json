        {
          "id": "t4.validator_run",
          "description": "Uses the repository Markdown validator.",
          "type": "command_ran",
          "params": {
            "any_of": ["npm run format:check", "format:check", "prettier"]
          },
          "critical": false
        },
        {
          "id": "t4.no_modification",
          "description": "No file was modified.",
          "type": "no_change",
          "critical": true
        }
      ]
    },
