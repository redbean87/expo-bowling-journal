    {
      "id": 4,
      "file": "t4.txt",
      "title": "Semantic judgment of the asterisks-in-table-cells claim",
      "expect_commit": false,
      "clean_tree_after": true,
      "no_change": true,
      "semantic_verdict": "claim is false; no documentation change warranted; required diff checks run",
      "requirements": [
        {
          "id": "t4.verdict_false",
          "description": "Delivers a verdict that the claim is false/incorrect.",
          "type": "text_regex",
          "params": {
            "pattern": "(?i)(claim is (false|incorrect|invalid|not true)|false\\.|not true|incorrect\\b|is false)"
          },
          "critical": true
        },
        {
          "id": "t4.no_change_warranted",
          "description": "Determines that no documentation change is warranted (semantically equivalent wording accepted).",
          "type": "text_regex",
          "params": {
            "pattern": "(?i)(?:no\\s+(?:documentation\\s+|doc\\s+)?(?:change|edit|update|modification|fix|action)\\b[^.\\n]{0,60}?\\b(?:warranted|needed|required|necessary|is\\s+(?:needed|required|warranted))|(?:documentation\\s+|doc\\s+)?(?:change|edit|update|modification|fix)\\b[^.\\n]{0,60}?\\b(?:warranted|needed|required|necessary)\\b\\s*\\?\\s*no\\b|not\\s+warranted|no\\s+(?:edit|modification)\\b)"
          },
          "critical": true
        },
        {
          "id": "t4.diff_check",
          "description": "Runs git diff --check.",
          "type": "command_ran",
          "params": { "any_of": ["git diff --check"] },
          "critical": true
        },
        {
          "id": "t4.diff_staged",
          "description": "Runs git diff --staged (or --cached).",
          "type": "command_ran",
          "params": { "any_of": ["git diff --staged", "git diff --cached"] },
          "critical": true
